{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "com.object.browser",
  "name": "Object Storage",
  "version": "0.4.2",
  "publisher": "huangqiang",
  "description": "Browse and read/write Alibaba Cloud OSS, MinIO and other S3-compatible object storage, with large-directory pagination and list virtualization.",
  "icon": "assets/plugin.svg",
  "source": "https://github.com/huangqiang008/dbx-object-storage",
  "homepage": "https://github.com/huangqiang008/dbx-object-storage",
  "engines": { "dbx": ">=0.6.0", "host_api": "1" },
  "permissions": ["host.workbench", "host.storage", "host.events", "host.filesystem"],
  "entrypoints": {
    "ui": { "root": "ui", "entry": "ui/index.html" },
    "backend": {
      "protocol_versions": [1],
      "transport": "stdio-jsonl",
      "executable": "bin/windows-x64/backend.exe"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "com.object.browser.connection",
      "label": "Alibaba Cloud OSS / S3 Compatible",
      "icon": "assets/plugin.svg",
      "database_type": "oss",
      "fields": [
        { "key": "display_name", "label": "连接名称", "type": "text", "binding": "name", "required": true },
        {
          "key": "provider", "label": "Provider", "type": "select", "binding": "config",
          "required": false, "default": "aliyun",
          "options": [
            { "value": "aliyun", "label": "Alibaba Cloud OSS" },
            { "value": "s3", "label": "S3 Compatible (MinIO, etc.)" }
          ]
        },
        { "key": "access_key_id", "label": "AccessKeyId", "type": "text", "binding": "config", "required": true },
        {
          "key": "access_key_secret", "label": "Secret", "type": "password", "binding": "secret",
          "required": true, "description": "AccessKeySecret"
        },
        { "key": "endpoint", "label": "Endpoint", "type": "text", "binding": "config", "required": true },
        {
          "key": "region", "label": "Region", "type": "text", "binding": "config",
          "required": false, "description": "可选，少数服务需显式指定",
          "visible_when": { "field": "provider", "one_of": ["s3"] }
        },
        {
          "key": "path_style", "label": "Path Style", "type": "boolean", "binding": "config",
          "required": false, "default": false,
          "description": "自建 MinIO 建议开启（以路径形式寻址）",
          "visible_when": { "field": "provider", "one_of": ["s3"] }
        },
        { "key": "bucket", "label": "Bucket", "type": "text", "binding": "config", "required": false }
      ],
      "workbench": "com.object.browser.main",
      "capabilities": ["test", "connect", "disconnect"]
    },
    {
      "type": "workbench",
      "id": "com.object.browser.main",
      "label": "Object Storage",
      "icon": "assets/plugin.svg"
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "对象存储",
      "contributions": {
        "com.object.browser.connection": {
          "label": "对象存储（阿里云 OSS / S3 兼容）",
          "fields": {
            "provider": {
              "label": "存储类型",
              "options": {
                "aliyun": "阿里云 OSS",
                "s3": "S3 兼容（MinIO 等）"
              }
            },
            "access_key_id": { "label": "AccessKeyId" },
            "access_key_secret": { "label": "Secret", "description": "AccessKeySecret（访问密钥）" },
            "endpoint": { "label": "接入点" },
            "region": { "label": "Region" },
            "path_style": { "label": "Path Style", "description": "自建 MinIO 建议开启" },
            "bucket": { "label": "Bucket" }
          }
        },
        "com.object.browser.main": { "label": "对象存储" }
      }
    }
  }
}
