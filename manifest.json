{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "com.object.browser",
  "name": "Object Storage",
  "version": "1.2.0",
  "publisher": "huangqiang",
  "description": "Browse and read/write Alibaba Cloud OSS, MinIO and other S3-compatible object storage, with large-directory pagination and list virtualization.",
  "icon": "assets/plugin.svg",
  "source": "https://github.com/huangqiang008/dbx-object-storage",
  "homepage": "https://github.com/huangqiang008/dbx-object-storage",
  "engines": { "dbx": ">=0.6.0", "host_api": "1" },
  "permissions": ["host.workbench", "host.storage", "host.events", "host.filesystem"],
  "entrypoints": {
    "ui": { "root": "ui", "entry": "ui/index.html" },
    "backend": {
      "protocol_versions": [1],
      "transport": "stdio-jsonl",
      "executable": "bin/windows-x64/backend.exe"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "com.object.browser.connection",
      "label": "Alibaba Cloud OSS / S3 Compatible",
      "icon": "assets/plugin.svg",
      "database_type": "oss",
      "fields": [
        { "key": "display_name", "label": "连接名称", "type": "text", "binding": "name", "required": true },
        {
          "key": "provider", "label": "存储类型", "type": "select", "binding": "config",
          "required": false, "default": "aliyun",
          "options": [
            { "value": "aliyun", "label": "阿里云 OSS" },
            { "value": "tencent-cos", "label": "腾讯云 COS" },
            { "value": "huawei-obs", "label": "华为云 OBS" },
            { "value": "aws-s3", "label": "AWS S3" },
            { "value": "minio", "label": "MinIO" },
            { "value": "cloudflare-r2", "label": "Cloudflare R2" },
            { "value": "wasabi", "label": "Wasabi" },
            { "value": "backblaze-b2", "label": "Backblaze B2" },
            { "value": "s3", "label": "其他 S3 兼容服务" }
          ]
        },
        { "key": "access_key_id", "label": "AccessKeyId", "type": "text", "binding": "config", "required": true },
        {
          "key": "access_key_secret", "label": "Secret", "type": "password", "binding": "secret",
          "required": true, "description": "AccessKeySecret"
        },
        {
          "key": "session_token", "label": "STS Token", "type": "password", "binding": "secret",
          "required": false, "description": "使用 STS 临时凭证时填写（与临时 AccessKeyId / Secret 成对下发）。留空表示使用长期密钥。"
        },
        { "key": "endpoint", "label": "Endpoint", "type": "text", "binding": "config", "required": true, "description": "接入点，含协议与端口。例如：阿里云 oss-cn-hangzhou.aliyuncs.com、腾讯云 cos.ap-guangzhou.myqcloud.com、华为云 obs.cn-north-1.myhuaweicloud.com、AWS s3.amazonaws.com、MinIO http://192.168.1.10:9000" },
        {
          "key": "region", "label": "Region", "type": "text", "binding": "config",
          "required": false, "description": "可选，部分服务需显式指定",
          "visible_when": { "field": "provider", "one_of": ["tencent-cos", "huawei-obs", "aws-s3", "minio", "cloudflare-r2", "wasabi", "backblaze-b2", "s3"] }
        },
        {
          "key": "path_style", "label": "Path Style", "type": "boolean", "binding": "config",
          "required": false, "default": false,
          "description": "自建 MinIO 建议开启（以路径形式寻址）",
          "visible_when": { "field": "provider", "one_of": ["tencent-cos", "huawei-obs", "aws-s3", "minio", "cloudflare-r2", "wasabi", "backblaze-b2", "s3"] }
        },
        { "key": "bucket", "label": "Bucket", "type": "text", "binding": "config", "required": false },
        {
          "key": "read_only", "label": "只读模式", "type": "boolean", "binding": "config",
          "required": false, "default": false,
          "description": "开启后该连接仅可浏览、预览与下载，上传/改名/删除等写操作一律被拒绝。适合生产桶或共享存储。"
        },
        {
          "key": "skip_verify_tls", "label": "跳过 TLS 证书校验", "type": "boolean", "binding": "config",
          "required": false, "default": false,
          "description": "关闭服务端证书校验，仅用于自签/内网端点。会失去中间人攻击（MITM）防护，请仅在可信网络使用。"
        },
        {
          "key": "ca_cert", "label": "自定义 CA 证书（PEM）", "type": "text", "binding": "config",
          "required": false,
          "description": "粘贴服务端 CA 的 PEM 文本（优先于「跳过校验」，仍会验证证书链）。适用于私有 CA 签发的 HTTPS 端点。"
        }
      ],
      "workbench": "com.object.browser.main",
      "capabilities": ["test", "connect", "disconnect"]
    },
    {
      "type": "workbench",
      "id": "com.object.browser.main",
      "label": "Object Storage",
      "icon": "assets/plugin.svg"
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "对象存储",
      "contributions": {
        "com.object.browser.connection": {
          "label": "对象存储（阿里云 OSS / S3 兼容）",
          "fields": {
        "provider": {
          "label": "存储类型",
          "options": {
            "aliyun": "阿里云 OSS",
            "tencent-cos": "腾讯云 COS",
            "huawei-obs": "华为云 OBS",
            "aws-s3": "AWS S3",
            "minio": "MinIO",
            "cloudflare-r2": "Cloudflare R2",
            "wasabi": "Wasabi",
            "backblaze-b2": "Backblaze B2",
            "s3": "其他 S3 兼容服务"
          }
        },
            "access_key_id": { "label": "AccessKeyId" },
            "access_key_secret": { "label": "Secret", "description": "AccessKeySecret（访问密钥）" },
            "session_token": { "label": "STS Token", "description": "使用 STS 临时凭证时填写（与临时 AccessKeyId / Secret 成对下发）。留空表示使用长期密钥。" },
            "endpoint": { "label": "接入点" },
            "region": { "label": "Region" },
            "path_style": { "label": "Path Style", "description": "自建 MinIO 建议开启" },
            "bucket": { "label": "Bucket" },
            "read_only": { "label": "只读模式", "description": "开启后该连接仅可浏览、预览与下载，所有写操作被拒绝。" },
            "skip_verify_tls": { "label": "跳过 TLS 证书校验", "description": "关闭服务端证书校验，仅用于自签/内网端点。会失去中间人攻击防护，请仅在可信网络使用。" },
            "ca_cert": { "label": "自定义 CA 证书（PEM）", "description": "粘贴服务端 CA 的 PEM 文本（优先于「跳过校验」，仍会验证证书链）。适用于私有 CA 签发的 HTTPS 端点。" }
          }
        },
        "com.object.browser.main": { "label": "对象存储" }
      }
    }
  }
}
